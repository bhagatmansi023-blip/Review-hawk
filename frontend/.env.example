# CodeHawk Frontend Environment Variables
# Note: Variables prefixed with VITE_ are exposed to the client-side bundle.
# NEVER put server-side secrets (like GITHUB_CLIENT_SECRET or DJANGO_SECRET_KEY) in this file.

# Base URL for the Django REST Framework backend API
# The backend handles GitHub OAuth via Django Allauth:
# - Initiation endpoint: ${VITE_API_BASE_URL}/accounts/github/login/
# - Server-side callback: ${VITE_API_BASE_URL}/accounts/github/login/callback/
VITE_API_BASE_URL=http://localhost:8000

# Public GitHub OAuth Client ID (Optional public identifier for direct client-initiated OAuth)
# Note: Server-side exchange is managed securely by Django backend.
VITE_GITHUB_CLIENT_ID=your_github_client_id_here

# Frontend Application Base URL
VITE_APP_URL=http://localhost:5173

# Review Hawk Frontend Environment Variables
# Note: Variables prefixed with VITE_ are exposed to the client-side bundle.
# NEVER put server-side secrets (like GITHUB_CLIENT_SECRET) in this file.

# Base URL for the Django REST Framework backend API
VITE_API_BASE_URL=http://localhost:8000

# GitHub OAuth Client ID (Public identifier provided by GitHub OAuth App)
VITE_GITHUB_CLIENT_ID=your_github_client_id_here

# Frontend Application Base URL
VITE_APP_URL=http://localhost:5173

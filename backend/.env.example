# Django
SECRET_KEY=your-django-secret-key
DEBUG=True

# Database (PostgreSQL)
DB_NAME=reviewhawk
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=5432

# GitHub OAuth App (django-allauth)
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret

# Webhook
# Full public URL that GitHub will POST events to, e.g. via ngrok during dev:
#   https://<your-ngrok-id>.ngrok.io/api/webhook/webhook/
WEBHOOK_URL=https://your-public-domain.example.com/api/webhook/webhook/
GITHUB_WEBHOOK_SECRET=a-long-random-secret-string

# Frontend
FRONTEND_URL=http://localhost:5173

# Google Gemini LLM
GEMINI_API_KEY=your-google-gemini-api-key
# Optional: override the default model
# GEMINI_MODEL=gemini-2.5-flash

# Celery / Redis
# Install Redis locally or use a managed service (e.g. Redis Cloud free tier)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Optional: lower on free-tier machines to avoid API rate limits
# CELERY_WORKER_CONCURRENCY=1
